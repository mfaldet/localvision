{
  "name": "localvision",
  "version": "0.1.0",
  "description": "Beautiful community data visualization — interactive maps + linked KPI charts",
  "type": "module",
  "main": "./dist/localvision.umd.cjs",
  "module": "./dist/localvision.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/localvision.js",
      "require": "./dist/localvision.umd.cjs"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.lib.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "data-visualization",
    "choropleth",
    "census",
    "acs",
    "maplibre",
    "geospatial",
    "community-data",
    "dashboard"
  ],
  "author": "Mac Faldet <mac@faldetadvisory.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfaldet/localvision.git"
  },
  "bugs": {
    "url": "https://github.com/mfaldet/localvision/issues"
  },
  "homepage": "https://mfaldet.github.io/localvision/",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.16",
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
